# Variables de docker-compose.yml (Actividad 9). Copiar a .env para cambiar valores locales:
#   cp .env.example .env
# docker compose lee .env automáticamente. Nunca poner secretos ni tokens aquí.

# Puertos publicados en 127.0.0.1 del host.
# 5000 suele estar ocupado en macOS (AirPlay Receiver), por eso MLflow usa 5001 por defecto.
API_PORT=8000
MLFLOW_PORT=5001

# Límites de recursos por contenedor (Compose v2: deploy.resources.limits).
# Valores por defecto comparables con instancias de 2 vCPU y 1 a 4 GB (ver docs FinOps).
API_CPU_LIMIT=2.0
API_MEM_LIMIT=1g
MLFLOW_CPU_LIMIT=1.0
MLFLOW_MEM_LIMIT=1g

# Tamaño máximo de lote de P3 (1 a 100). P2 usa SERVING_MAX_BATCH en el código (500).
MIBICI_MAX_BATCH_SIZE=100
