name: mibici-equipo49

# MLflow sustituye {parametro} con str.format (no Jinja). Por eso los comandos son
# planos: la logica de "parametro vacio" vive en los modulos de Python.
#
# Los valores por defecto de rutas, ventana, semilla, experimento y URI de tracking
# estan en mibici_ml/config.py y no se repiten aqui. Un parametro vacio = config.py.
python_env: python_env.yaml

entry_points:
  ingest:
    parameters:
      start_month: {type: string, default: "", description: "Primer mes AAAA-MM. Vacio = config.START_MONTH."}
      end_month: {type: string, default: "", description: "Ultimo mes AAAA-MM. Vacio = config.END_MONTH."}
      source_dir: {type: string, default: "", description: "Carpeta con CSV ya descargados. Vacio = descargar."}
      refresh: {type: string, default: "false", description: "true para descargar y aceptar nuevos hashes."}
    command: "python -m mibici_ml.dataset ingest --start-month {start_month} --end-month {end_month} --source-dir {source_dir} --refresh {refresh}"

  train:
    parameters:
      question: {type: string, description: "Pregunta: p1, p2 o p3."}
      model: {type: string, default: "", description: "P2: logistica o hist_gb."}
      final_k: {type: string, default: "", description: "P3: k final elegido tras evaluar (obligatorio para p3)."}
      output_dir: {type: string, default: "/tmp/mibici-runs", description: "Directorio de artefactos del run. Por defecto temporal para no sobrescribir reports/tables versionado."}
      with_mlflow: {type: string, default: "true", description: "true o false: registrar en MLflow."}
    command: "python -m mibici_ml.modeling.train --question {question} --model {model} --final-k {final_k} --output-dir {output_dir} --with-mlflow {with_mlflow}"

  search:
    # Busqueda anidada de P2: un run padre y un hijo por combinacion. Solo validacion.
    parameters: {}
    command: "python -m mibici_ml.modeling.search"

  search_p3:
    # P3 baseline historico k=5 mas cinco candidatos anidados; no promueve por defecto.
    parameters:
      input_path: {type: string, default: "", description: "CSV agregado P3; vacio = config.py."}
      output_dir: {type: string, default: "", description: "Directorio temporal unico; nunca reports/tables."}
      k_values: {type: string, default: "", description: "Ks candidatos separados por coma; vacio = config.py."}
      random_seed: {type: string, default: "", description: "Semilla; vacio = config.py."}
      n_init: {type: string, default: "", description: "n_init KMeans; vacio = config.py."}
      register_best: {type: string, default: "false", description: "true para registrar, validar y asignar alias."}
      registry_model_name: {type: string, default: "", description: "Nombre Registry; vacio = config.py."}
      champion_alias: {type: string, default: "", description: "Alias; vacio = config.py."}
      selected_k: {type: string, default: "", description: "Override manual; vacio = recomendacion."}
    command: "python -m mibici_ml.modeling.search_p3 --input-path {input_path} --output-dir {output_dir} --k-values {k_values} --random-seed {random_seed} --n-init {n_init} --register-best {register_best} --registry-model-name {registry_model_name} --champion-alias {champion_alias} --selected-k {selected_k}"
