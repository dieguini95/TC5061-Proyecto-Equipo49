# Generador de carga Locust para el perfil "loadtest" de docker-compose.yml (Actividad 9).
# Se ejecuta dentro de mibici-net y apunta a http://api:8000. Sin datos ni secretos.
#
#   docker compose --profile loadtest run --rm locust
#
# Las mediciones oficiales (S1 a S4) se corren desde el host con scripts/run_a9_scenarios.py.

FROM docker.io/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /load

RUN groupadd --system --gid 10001 load \
    && useradd --system --uid 10001 --gid load --no-create-home --shell /usr/sbin/nologin load

COPY requirements-loadtest.txt ./
RUN pip install --no-cache-dir --no-compile -r requirements-loadtest.txt

COPY load_tests ./load_tests

USER 10001:10001

ENTRYPOINT ["locust"]
CMD ["-f", "load_tests/locustfile.py", "--headless", "--only-summary", \
     "-u", "5", "-r", "5", "-t", "20s", "MiBiciMixedUser"]
